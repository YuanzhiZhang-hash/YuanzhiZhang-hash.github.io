"use client";import data from '@/public/data/snapshot.json';export default function Moments(){return <div className="max-w-3xl mx-auto px-4 py-10"><h1 className="text-3xl font-bold mb-8">说说</h1>{data.chatters.map((c:any)=><article key={c.id} className="glass-card p-6 mb-5"><p className="text-xs text-slate-500 mb-3">{c.created_at.slice(0,16).replace('T',' ')}</p><p className="whitespace-pre-line leading-relaxed">{c.content}</p><div className="grid grid-cols-2 gap-2 mt-4">{c.images.map((image:string)=><a key={image} href={image} target="_blank" rel="noopener noreferrer"><img src={image} alt="说说配图" className="w-full rounded-xl"/></a>)}</div></article>)}</div>;}
